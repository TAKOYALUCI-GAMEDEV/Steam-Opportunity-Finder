{
  "name": "steam-opportunity-finder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Find underserved Steam markets that fit what your team can actually build.",
  "scripts": {
    "dev": "vite",
    "build": "npm run data && tsc --noEmit && vite build",
    "build:app": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data": "tsx pipeline/build-dataset.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
